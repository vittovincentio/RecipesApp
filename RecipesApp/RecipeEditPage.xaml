<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipesApp.RecipeEditPage">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="10">

            <Label Text="Название" FontAttributes="Bold"/>
            <Entry x:Name="NameEntry" Placeholder="Введите название"/>

            <Label Text="Описание" FontAttributes="Bold"/>
            <Editor x:Name="DescriptionEditor"
                    Placeholder="Введите описание"
                    HeightRequest="100"/>

            <Label Text="Ингредиенты" FontAttributes="Bold"/>
            <Editor x:Name="IngredientsEditor"
                    Placeholder="Введите ингредиенты через запятую"
                    HeightRequest="120"/>

            <Button Text="Сохранить" Clicked="OnSaveClicked"/>
            <Button Text="Назад" Clicked="OnBackClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>